# Copiar a .env y rellenar. Sin ninguna de estas variables el API arranca en
# modo desarrollo: SQLite local y el enlace mágico impreso en el log.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Firma de sesiones y tokens. OBLIGATORIA en producción.
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de este API: con ella se firman los enlaces mágicos y el JWT (iss).
# En Vercel el API se sirve tras el proxy del frontend: aquí va la URL del frontend.
BETTER_AUTH_URL=http://localhost:3000

# Sólo si el API vive tras un proxy: dónde pedir las claves públicas del JWT.
# Por defecto se derivan de BETTER_AUTH_URL.
AUTH_JWKS_URL=

# URL pública del frontend: destino del enlace ya verificado y audiencia del JWT (aud).
APP_URL=http://localhost:5174

# Orígenes que pueden llamar al API con credenciales, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Turso. Si TURSO_DATABASE_URL está vacía, todo (catálogo, pedidos y auth) vive
# en un SQLite local en data/33rpm.db. Para crear el esquema y sembrar el
# catálogo en la base configurada: pnpm db:push
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Envío del enlace mágico (Resend). Sin clave, el enlace se imprime en el log y
# no se manda ningún correo; en producción, sin clave, el acceso falla.
RESEND_API_KEY=
MAIL_FROM=33rpm <onboarding@resend.dev>

# Fotos de los discos (Vercel Blob). Sin token, la subida responde 503.
# Se obtiene conectando el store al proyecto en Vercel y con `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Pagos con Mercado Pago (Checkout Pro). Sin token, el checkout deja el pedido
# pendiente y no cobra. El secreto es el de "Tus integraciones > Webhooks".
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Sólo si Mercado Pago debe notificar a una URL distinta de APP_URL/api/pagos/webhook.
MP_NOTIFICATION_URL=

# Correos que reciben rol admin al registrarse, separados por coma.
ADMIN_EMAILS=

# Detrás de un proxy inverso: número de saltos de confianza para X-Forwarded-For.
TRUST_PROXY=loopback
